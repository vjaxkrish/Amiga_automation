[Unit]
Description=RTCM forwarder, radio B to LG580P
After=multi-user.target

[Service]
Type=simple
User=amiga-pi
WorkingDirectory=/home/amiga-pi
ExecStart=/usr/bin/python3 /home/amiga-pi/rtcm_forward.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
